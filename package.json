{
  "name": "claude-status",
  "displayName": "Claude Status",
  "description": "Every Claude Code chat on this computer and your SSH hosts in one view: who needs you, plan usage, subagents, and Talpa, the animated pet. Runs on your side, also in Remote-SSH windows.",
  "version": "1.14.1",
  "publisher": "wzaielamri",
  "author": {
    "name": "Wadhah Zai El Amri",
    "url": "https://wzaielamri.github.io/"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/wzaielamri/claude-status-vscode.git"
  },
  "homepage": "https://github.com/wzaielamri/claude-status-vscode#readme",
  "bugs": {
    "url": "https://github.com/wzaielamri/claude-status-vscode/issues"
  },
  "private": true,
  "engines": {
    "vscode": "^1.90.0"
  },
  "icon": "media/icon.png",
  "categories": [
    "Other"
  ],
  "keywords": [
    "claude",
    "claude code",
    "ssh",
    "remote",
    "status"
  ],
  "extensionKind": [
    "ui"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onUri"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "claudeStatus",
          "title": "Claude Status",
          "icon": "media/talpa.svg"
        }
      ]
    },
    "views": {
      "claudeStatus": [
        {
          "type": "webview",
          "id": "claudeStatus.view",
          "name": "Chats"
        }
      ]
    },
    "commands": [
      {
        "command": "claudeStatus.refresh",
        "title": "Refresh",
        "category": "Claude Status",
        "icon": "$(refresh)"
      },
      {
        "command": "claudeStatus.pickHosts",
        "title": "Show Claude on SSH Hosts…",
        "category": "Claude Status",
        "icon": "$(remote-explorer)"
      },
      {
        "command": "claudeStatus.openInEditor",
        "title": "Open in Editor Tab",
        "category": "Claude Status",
        "icon": "$(link-external)"
      },
      {
        "command": "claudeStatus.newChat",
        "title": "New Chat…",
        "category": "Claude Status",
        "icon": "$(add)"
      },
      {
        "command": "claudeStatus.findChat",
        "title": "Find a Chat…",
        "category": "Claude Status",
        "icon": "$(search)"
      },
      {
        "command": "claudeStatus.nextChat",
        "title": "Go to the Chat That Needs You",
        "category": "Claude Status",
        "icon": "$(bell-dot)"
      },
      {
        "command": "claudeStatus.showRemoved",
        "title": "Show Removed Chats Again",
        "category": "Claude Status"
      },
      {
        "command": "claudeStatus.setupUsageBars",
        "title": "Set Up Plan Usage Bars…",
        "category": "Claude Status"
      },
      {
        "command": "claudeStatus.removeUsageBars",
        "title": "Remove the Plan Usage Status-Line Snippet…",
        "category": "Claude Status"
      },
      {
        "command": "claudeStatus.openUsagePage",
        "title": "Open Usage Page on claude.ai",
        "category": "Claude Status"
      },
      {
        "command": "claudeStatus.toggleDemo",
        "title": "Toggle Demo Data (for Screenshots)",
        "category": "Claude Status"
      },
      {
        "command": "claudeStatus.showLog",
        "title": "Show Log",
        "category": "Claude Status"
      },
      {
        "command": "claudeStatus.switchAccount",
        "title": "Default Claude Account…",
        "category": "Claude Status",
        "icon": "$(account)"
      },
      {
        "command": "claudeStatus.accounts",
        "title": "Claude Accounts…",
        "category": "Claude Status",
        "icon": "$(organization)"
      },
      {
        "command": "claudeStatus.addAccount",
        "title": "Add Claude Account…",
        "category": "Claude Status"
      },
      {
        "command": "claudeStatus.sendPlanFeedback",
        "title": "Send Feedback to Claude",
        "category": "Claude Status",
        "icon": "$(send)"
      },
      {
        "command": "claudeStatus.planComment.add",
        "title": "Add Comment for Claude",
        "enablement": "!commentIsEmpty"
      },
      {
        "command": "claudeStatus.planComment.delete",
        "title": "Delete Comment",
        "icon": "$(trash)"
      }
    ],
    "keybindings": [
      {
        "command": "claudeStatus.nextChat",
        "key": "ctrl+alt+shift+c",
        "mac": "cmd+alt+shift+c"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "claudeStatus.newChat",
          "when": "view == claudeStatus.view",
          "group": "navigation@1"
        },
        {
          "command": "claudeStatus.findChat",
          "when": "view == claudeStatus.view",
          "group": "navigation@2"
        },
        {
          "command": "claudeStatus.pickHosts",
          "when": "view == claudeStatus.view",
          "group": "navigation@3"
        },
        {
          "command": "claudeStatus.refresh",
          "when": "view == claudeStatus.view",
          "group": "navigation@4"
        },
        {
          "command": "claudeStatus.openInEditor",
          "when": "view == claudeStatus.view",
          "group": "more@1"
        },
        {
          "command": "claudeStatus.showRemoved",
          "when": "view == claudeStatus.view",
          "group": "more@2"
        },
        {
          "command": "claudeStatus.setupUsageBars",
          "when": "view == claudeStatus.view",
          "group": "more@3"
        },
        {
          "command": "claudeStatus.openUsagePage",
          "when": "view == claudeStatus.view",
          "group": "more@4"
        },
        {
          "command": "claudeStatus.switchAccount",
          "when": "view == claudeStatus.view",
          "group": "more@5"
        },
        {
          "command": "claudeStatus.accounts",
          "when": "view == claudeStatus.view",
          "group": "more@6"
        }
      ],
      "editor/title": [
        {
          "command": "claudeStatus.sendPlanFeedback",
          "group": "navigation",
          "when": "resourcePath =~ /\\/\\.claude[^/]*\\/plans\\/[^/]+\\.md$/"
        }
      ],
      "comments/commentThread/context": [
        {
          "command": "claudeStatus.planComment.add",
          "group": "inline",
          "when": "commentController == claudeStatus.planFeedback"
        }
      ],
      "comments/commentThread/title": [
        {
          "command": "claudeStatus.planComment.delete",
          "group": "navigation",
          "when": "commentController == claudeStatus.planFeedback && !commentThreadIsEmpty"
        }
      ],
      "commandPalette": [
        {
          "command": "claudeStatus.planComment.add",
          "when": "false"
        },
        {
          "command": "claudeStatus.planComment.delete",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "Claude Status",
      "properties": {
        "claudeStatus.sshHosts": {
          "scope": "machine",
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "SSH hosts (names from `~/.ssh/config`) whose Claude Code chats are shown too. Use **Claude Status: Show Claude on SSH Hosts…** to pick them. Needs key-based login (the check never asks for a password) and `python3` 3.7+ on the host; nothing is installed there.",
          "order": 1
        },
        "claudeStatus.includeCurrentRemote": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "In a Remote-SSH window, also show the chats of the host the window is connected to.",
          "order": 2
        },
        "claudeStatus.remotePollSeconds": {
          "type": "integer",
          "default": 30,
          "minimum": 10,
          "maximum": 600,
          "markdownDescription": "How often SSH hosts are checked, in seconds.",
          "order": 3
        },
        "claudeStatus.sshUsage": {
          "type": "string",
          "enum": [
            "once",
            "all",
            "none"
          ],
          "enumDescriptions": [
            "Once per account: an account logged in on this computer and on a host (or on two hosts) has one plan usage, shown where the account is listed first, with the newest numbers of them all.",
            "On every host: each machine's own numbers, under each copy of the account.",
            "Not on hosts: no SSH host's account shows plan usage."
          ],
          "default": "once",
          "markdownDescription": "Plan usage on SSH hosts' accounts.",
          "order": 3
        },
        "claudeStatus.pollInterval": {
          "type": "integer",
          "default": 2000,
          "minimum": 1000,
          "maximum": 60000,
          "markdownDescription": "How often this computer's chats are checked while the view is open, in milliseconds (every 10 s while it's hidden).",
          "order": 4
        },
        "claudeStatus.extraConfigDirs": {
          "scope": "machine",
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "More Claude Code config folders to read. `~/.claude`, every `~/.claude-*` folder and `$CLAUDE_CONFIG_DIR` are found without this.",
          "order": 5
        },
        "claudeStatus.openIn": {
          "type": "string",
          "enum": [
            "vscode",
            "system"
          ],
          "enumDescriptions": [
            "Open chats in VS Code's terminal (on the right machine: here, or the host this window is connected to).",
            "Open chats in your desktop's terminal app, like the Plasma and GNOME widgets do."
          ],
          "default": "vscode",
          "markdownDescription": "Where chats open when you click them.",
          "order": 6
        },
        "claudeStatus.reopenIn": {
          "type": "string",
          "enum": [
            "terminal",
            "claudeCode"
          ],
          "enumDescriptions": [
            "Reopen recent chats in a terminal (claude --resume), as `#claudeStatus.openIn#` says.",
            "Reopen recent chats in a Claude Code tab, in the VS Code window that has the chat's folder (on an SSH host's chats: connected to it)."
          ],
          "default": "terminal",
          "markdownDescription": "Where recent chats reopen: the **Terminal | Claude Code tab** switch above them. Without a `claude` command they reopen in Claude Code.",
          "order": 7
        },
        "claudeStatus.notifyWaiting": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Notify when a chat needs your input. (If the Plasma or GNOME widget runs too, turn this off in one of them.)",
          "order": 10
        },
        "claudeStatus.notifyDone": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Notify when a chat finishes a turn that took at least `#claudeStatus.notifyDoneMinSeconds#` seconds.",
          "order": 11
        },
        "claudeStatus.notifyDoneMinSeconds": {
          "type": "integer",
          "default": 30,
          "minimum": 0,
          "maximum": 3600,
          "markdownDescription": "Shortest turn, in seconds, that gets a \"finished\" notification.",
          "order": 12
        },
        "claudeStatus.notifySound": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Play a sound with notifications (Linux: PipeWire, PulseAudio or ALSA; nothing plays while Do Not Disturb is on).",
          "order": 13
        },
        "claudeStatus.soundVolume": {
          "type": "integer",
          "default": 70,
          "minimum": 0,
          "maximum": 100,
          "markdownDescription": "Notification sound volume, in percent.",
          "order": 14
        },
        "claudeStatus.soundWaiting": {
          "type": "string",
          "default": "message-new-instant",
          "markdownDescription": "Sound when a chat needs you: sound-theme names (comma-separated, the first one found plays) or a sound file.",
          "order": 15
        },
        "claudeStatus.soundDone": {
          "type": "string",
          "default": "outcome-success,complete",
          "markdownDescription": "Sound when a chat finishes.",
          "order": 16
        },
        "claudeStatus.soundFailed": {
          "type": "string",
          "default": "dialog-error",
          "markdownDescription": "Sound when a chat fails.",
          "order": 17
        },
        "claudeStatus.awayDigest": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "When you come back to VS Code after `#claudeStatus.awayMinutes#` minutes or more, one notification sums up what happened meanwhile (chats that finished, failed or need you, limits that reset). While you're away, notifications of finished chats wait for it.",
          "order": 18
        },
        "claudeStatus.awayMinutes": {
          "type": "integer",
          "default": 5,
          "minimum": 1,
          "maximum": 240,
          "markdownDescription": "How long, in minutes, no VS Code window has to be in use to count as away (`#claudeStatus.awayDigest#`).",
          "order": 19
        },
        "claudeStatus.showPet": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Show Talpa, the animated pet.",
          "order": 20
        },
        "claudeStatus.chatPets": {
          "type": "integer",
          "default": 5,
          "minimum": 0,
          "maximum": 8,
          "markdownDescription": "Pets per account, one for each running chat (0 = none).",
          "order": 21
        },
        "claudeStatus.showTokens": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Show today's and this week's token totals per account.",
          "order": 22
        },
        "claudeStatus.showUsageInStatusBar": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Show the 5-hour plan usage next to the status bar item.",
          "order": 23
        },
        "claudeStatus.recentChats": {
          "type": "integer",
          "default": 5,
          "minimum": 0,
          "maximum": 20,
          "markdownDescription": "How many recent chats to list per account.",
          "order": 24
        },
        "claudeStatus.keepDoneHours": {
          "type": "integer",
          "default": 24,
          "minimum": 0,
          "maximum": 168,
          "markdownDescription": "Keep finished background chats listed for this many hours (0 = drop them right away).",
          "order": 25
        },
        "claudeStatus.usageCap": {
          "type": "integer",
          "default": 0,
          "minimum": 0,
          "maximum": 100,
          "markdownDescription": "A usage cap, in percent (0 = none): once one of an account's plan windows (5 hours, a week) reaches it, the account's chats at work on this computer are stopped, once in that window (in tmux and in a Claude Code tab the turn is interrupted, the chat stays open). Queued tasks wait until the window resets, and chats that keep going go on then. Chats you start or answer yourself afterwards aren't stopped again.",
          "order": 31
        },
        "claudeStatus.newChatModel": {
          "type": "string",
          "enum": [
            "opus",
            "sonnet",
            "fable",
            "haiku",
            ""
          ],
          "enumItemLabels": [
            "Opus",
            "Sonnet",
            "Fable",
            "Haiku",
            "Claude's default"
          ],
          "default": "opus",
          "markdownDescription": "The model new chats in a terminal or in the background start with (`claude --model`; **New Chat…** changes it). Not for a Claude Code tab: that has its own model setting.",
          "order": 32
        },
        "claudeStatus.newChatEffort": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high",
            "xhigh",
            "max",
            ""
          ],
          "enumItemLabels": [
            "Low",
            "Medium",
            "High",
            "Extra high",
            "Max",
            "Claude's default"
          ],
          "default": "xhigh",
          "markdownDescription": "The reasoning effort new chats in a terminal or in the background start with (`claude --effort`; **New Chat…** changes it).",
          "order": 33
        },
        "claudeStatus.newChatMode": {
          "type": "string",
          "enum": [
            "default",
            "acceptEdits",
            "plan",
            "auto",
            "dontAsk",
            "bypassPermissions",
            ""
          ],
          "enumItemLabels": [
            "Manual",
            "Accept edits",
            "Plan mode",
            "Auto mode",
            "Don't ask",
            "Bypass permissions",
            "Claude's default"
          ],
          "default": "",
          "markdownDescription": "The permission mode new chats in a terminal or in the background start in (`claude --permission-mode`; **New Chat…** changes it, Shift+Tab in the chat too). A background chat can start in auto mode or bypass permissions only once you turned that on in a terminal.",
          "order": 34
        },
        "claudeStatus.pythonPath": {
          "scope": "machine",
          "type": "string",
          "default": "python3",
          "markdownDescription": "Python 3.7+ used to read Claude Code's files on this computer.",
          "order": 30
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "check": "tsc -p . && tsc -p webview",
    "test": "node esbuild.mjs --tests && node --test out/test/*.test.js",
    "package": "node esbuild.mjs --production && vsce package --no-dependencies",
    "vscode:prepublish": "node esbuild.mjs --production"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "@types/vscode": "~1.90.0",
    "@vscode/vsce": "^3.6.0",
    "esbuild": "^0.25.0",
    "preact": "^10.27.0",
    "typescript": "^5.9.0"
  }
}
