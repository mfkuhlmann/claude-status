# Python bytecode (contains absolute paths of the machine that ran it)
__pycache__/
*.py[cod]

# Backups made by install.sh / editors
*.bak
*.bak.*
*~
.*.swp

# Local tooling
.venv/
.idea/
.vscode/
.env

# Renders from tools/render_popup.sh show your real chats; keep them and logs out
/*.png
*.log

# Claude Code config/state of any profile (~/.claude, ~/.claude-work,
# ~/.claude-personal, ...) and local-only instructions
.claude/
.claude-*/
.claude_*/
.claude.json
CLAUDE.local.md

# GNOME extension build output (gnome/build.sh)
gnome/build/
